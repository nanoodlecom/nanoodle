{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nanoodle",
  "compatibility_date": "2026-06-20",
  // Deploy-time only: stamp sw.js's cache name with the commit SHA so each release purges
  // stale offline caches automatically. No-op locally (no CI sha). See scripts/stamp-sw.mjs.
  "build": {
    "command": "node scripts/stamp-sw.mjs"
  },
  "observability": {
    "enabled": true
  },
  // Static site, plus one Worker route. Browsers cannot read Location on
  // redirect:"manual" (opaque redirect), so /api/resolve-content walks the
  // NanoGPT content 307 server-side and returns the file URL. Every other
  // path stays on the asset server and never enters the Worker.
  "main": "worker/entry.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/resolve-content"]
  }
}
