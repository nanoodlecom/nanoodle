    {
      "id": "c-intent",
      "type": "comment",
      "name": "Sing: idea to finished track",
      "x": 40,
      "y": -200,
      "w": 560,
      "fields": {
        "text": "Start with a song idea and the bands you like. Three text calls write lyrics, arrange them, and identify what would clash with that arrangement. The arrangement and avoid-list become one musical direction for MiniMax Music 3; the lyrics use its separate lyrics input. Change the idea or references to take the song somewhere else. Check the estimate before running; listen for the hook, instrumentation and vocal delivery. Exact duration and arrangement can vary.",
        "color": "yellow"
      }
    },
    {
      "id": "n1",
      "type": "text",
      "name": "Song idea",
      "x": 40,
      "y": 80,
      "w": 280,
      "fields": {
        "text": "Write a wistful 90s trip-hop track about the singularity."
      }
    },
    {
      "id": "n5",
      "type": "text",
      "name": "Preferred bands",
      "x": 40,
      "y": 360,
      "w": 280,
      "fields": {
        "text": "Portishead, Massive Attack, Tricky"
      }
    },
    {
      "id": "n6",
